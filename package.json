{
  "name": "keradrive",
  "private": true,
  "type": "module",
  "workspaces": ["api", "web"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -n api,web -c green,yellow \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w api",
    "typecheck": "tsc -p api --noEmit && tsc -p web --noEmit",
    "test": "node --test shared/*.test.ts",
    "admin:password": "node api/scripts/hash-password.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.9.0"
  }
}
