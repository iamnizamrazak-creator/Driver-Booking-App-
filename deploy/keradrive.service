# /etc/systemd/system/keradrive.service
[Unit]
Description=KeraDrive API + web apps
After=network.target

[Service]
Type=simple
User=keradrive
WorkingDirectory=/opt/keradrive/api
ExecStart=/usr/bin/node --env-file=/opt/keradrive/api/.env src/server.ts
Restart=always
RestartSec=3
Environment=NODE_ENV=production
# Hardening
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/keradrive/data

[Install]
WantedBy=multi-user.target
