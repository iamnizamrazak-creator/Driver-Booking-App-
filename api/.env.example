# Copy to api/.env and fill in.
PORT=4000
NODE_ENV=development
DATABASE_PATH=../data/keradrive.db
CITY=Kochi

# Public URL of the app, used for cookie security in production.
APP_URL=http://localhost:5173

# Google Identity Services: create an OAuth "Web application" client at
# https://console.cloud.google.com/apis/credentials and add your origins
# (http://localhost:5173 and https://your-domain) as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Comma-separated Google emails that may open the admin dashboard.
ADMIN_EMAILS=

# Username/password sign-in for the admin dashboard.
# Create the hash with `npm run admin:password` (the password itself is never stored).
# Can be a plain username or an email.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Razorpay (use rzp_test_* keys until you go live). Leave blank to use mock payments in development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Development only: shows an email-only login so you can test without Google.
# Never enable in production.
DEV_LOGIN=true
